DB_URL=jdbc:mysql://localhost:3306/review-shop-dev
DB_USERNAME=your-database-user
DB_PASSWORD=your-database-password
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=1
AUTH_RATE_LIMIT_ENABLED=true
PASSWORD_RESET_OTP_TTL_MINUTES=30
PASSWORD_RESET_OTP_PEPPER=generate-a-random-secret-at-least-32-bytes
PASSWORD_RESET_MINIMUM_RESPONSE_MILLIS=300
JWT_SECRET=generate-a-random-secret-at-least-32-bytes
JWT_ISSUER=review-shop-backend
JWT_AUDIENCE=review-shop-api
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
JWT_REFRESH_TOKEN_CLEANUP_CRON=0 0 3 * * *
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_SECURE=true
JWT_CSRF_COOKIE_NAME=csrf_token
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
PLATFORM_DEFAULT_FEE_RATE=0.5000
PAYOUT_ENCRYPTION_KEY=generate-a-dedicated-secret-at-least-32-bytes
WITHDRAWAL_MINIMUM=5000.00
WITHDRAWAL_FEE=
SERPAPI_API_KEY=your-serpapi-api-key
SERPAPI_BASE_URL=https://serpapi.com
JOB_ASSIGNMENT_CLAIM_TTL_MINUTES=10
JOB_ASSIGNMENT_EXPIRY_CLEANUP_CRON=0 * * * * *
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=generate-a-strong-admin-password
ADMIN_FULL_NAME=Platform Admin
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_REGION=auto
R2_UPLOAD_URL_DURATION=PT10M
R2_DOWNLOAD_URL_DURATION=PT30M
R2_MAX_IMAGE_SIZE=3145728
SEPAY_ENABLED=false
SEPAY_WEBHOOK_API_KEY=your-sepay-webhook-api-key
SEPAY_BANK_ACCOUNT=your-bank-account
SEPAY_BANK_CODE=your-bank-code
SEPAY_ACCOUNT_HOLDER=YOUR ACCOUNT HOLDER
SEPAY_PAYMENT_CODE_PREFIX=SEPAY
SEPAY_WEBHOOK_BANK_ACCOUNT=your-webhook-bank-account
